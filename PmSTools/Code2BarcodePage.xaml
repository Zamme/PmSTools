<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         xmlns:zxing="clr-namespace:ZXing.Net.Maui;assembly=ZXing.Net.MAUI"
                         xmlns:controls="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
                         xmlns:models="clr-namespace:PmSTools.Models"
                         xmlns:strings="clr-namespace:PmSTools.Resources.Languages"
                         x:Class="PmSTools.Code2BarcodePage"
                         Title="{x:Static strings:LangResources.BarcodePopupTitleText}"
                         BackgroundColor="White">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{x:Static strings:LangResources.BackText}" Order="Primary" Priority="0" Clicked="OnBackFromCode2BarcodeClicked" />
    </ContentPage.ToolbarItems>
    
    <Grid
        Padding="5"
        BackgroundColor="White">

        <ScrollView x:Name="scrollView"
                    VerticalOptions="FillAndExpand">
            <VerticalStackLayout x:Name="CodesStack"
                                 Padding="5"
                                 Spacing="10"
                                 BackgroundColor="White">
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
