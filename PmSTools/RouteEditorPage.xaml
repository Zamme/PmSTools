<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PmSTools"
             xmlns:models="clr-namespace:PmSTools.Models"
             xmlns:strings="clr-namespace:PmSTools.Resources.Languages"
             x:Class="PmSTools.RouteEditorPage"
             x:DataType="local:RouteEditorPage"
             Title="{x:Static strings:LangResources.RouteEditorTitleText}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{x:Static strings:LangResources.StartNearMeText}" Clicked="OnStartNearMeClicked" Priority="0" />
        <ToolbarItem Text="{x:Static strings:LangResources.OptimizeText}" Clicked="OnOptimizeRouteClicked" Priority="0" />
        <ToolbarItem Text="{x:Static strings:LangResources.FullMapText}" Clicked="FullRouteMap_ToolbarClicked" Priority="0" />
    </ContentPage.ToolbarItems>
    <ScrollView x:Name="RouteScrollView">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Padding="16" x:DataType="local:RouteEditorPage">
    <Grid Grid.Row="0"
              Margin="0,12,0,0"
              ColumnDefinitions="*,*"
              ColumnSpacing="10">
            <Button Grid.Column="0"
                Text="{x:Static strings:LangResources.TakeText}"
                ImageSource="camera_icon_01.png"
                FontSize="18"
                BackgroundColor="Blue"
                BorderColor="BlueViolet"
                BorderWidth="2"
                TextColor="WhiteSmoke"
                FontAttributes="Bold"
                SemanticProperties.Hint="{x:Static strings:LangResources.TakeAddressFromCameraHintText}"
                HorizontalOptions="Fill"
                HeightRequest="80"
                Clicked="OnTakeAddressPhotoClicked" />
            <Button Grid.Column="1"
                Text="{x:Static strings:LangResources.SelectText}"
                ImageSource="folder_icon_01.png"
                FontSize="18"
                BackgroundColor="Blue"
                BorderColor="BlueViolet"
                BorderWidth="2"
                TextColor="WhiteSmoke"
                FontAttributes="Bold"
                SemanticProperties.Hint="{x:Static strings:LangResources.TakeAddressFromFileHintText}"
                HorizontalOptions="Fill"
                HeightRequest="80"
                Clicked="OnOpenAddressPictureClicked" />
        </Grid>

         <Label x:Name="EmptyStopsLabel"
             Grid.Row="1"
               Margin="0,12,0,0"
               Text="{x:Static strings:LangResources.NoStopsYetText}"
               HorizontalOptions="Center" />

         <Frame Grid.Row="2"
             Margin="0,12,0,0"
             Padding="0">
             <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0"
                    ColumnDefinitions="*,Auto"
                    Margin="12,12,12,0">
                  <Label Grid.Column="0"
                         Text="{x:Static strings:LangResources.RouteMapText}"
                         FontAttributes="Bold" />
                  <Button Grid.Column="1"
                      x:DataType="local:RouteEditorPage"
                          Text="{x:Static strings:LangResources.RefreshText}"
                          FontSize="12"
                          Padding="8,4"
                          BackgroundColor="#2E7D32"
                          TextColor="White"
                          Clicked="OnRefreshRouteMapClicked">
                      <Button.Triggers>
                          <DataTrigger TargetType="Button"
                                       Binding="{Binding IsMapDirty}"
                                       Value="True">
                              <Setter Property="BackgroundColor" Value="#F57C00" />
                              <Setter Property="TextColor" Value="White" />
                          </DataTrigger>
                      </Button.Triggers>
                  </Button>
              </Grid>
              <Grid Grid.Row="1" HeightRequest="400">
                  <WebView x:Name="RouteMapWebView"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill"
                      Navigated="OnRouteMapNavigated" />
                  <Grid x:Name="RouteMapLoadingOverlay"
                        BackgroundColor="#66000000"
                    InputTransparent="True"
                        IsVisible="False">
                      <VerticalStackLayout HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           Spacing="8">
                          <ActivityIndicator IsRunning="True" Color="White" />
                          <Label Text="{x:Static strings:LangResources.GeocodingText}"
                                 TextColor="White"
                                 FontAttributes="Bold" />
                      </VerticalStackLayout>
                  </Grid>
                  <Button Text="⤢"
                      SemanticProperties.Hint="{x:Static strings:LangResources.OpenMapFullScreenHintText}"
                          Clicked="FullRouteMap_FloatingClicked"
                          BackgroundColor="#80000000"
                          TextColor="White"
                          WidthRequest="48"
                          HeightRequest="48"
                          CornerRadius="24"
                          FontSize="20"
                          HorizontalOptions="End"
                          VerticalOptions="Start"
                          Margin="10" />
              </Grid>
             </Grid>
         </Frame>

         <CollectionView Grid.Row="3"
                        x:DataType="local:RouteEditorPage"
                        Margin="0,12,0,0"
                        HeightRequest="260"
                        ItemsSource="{Binding Stops}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DeliveryRouteStop">
                    <Frame Margin="0,0,0,10" Padding="12" x:DataType="models:DeliveryRouteStop">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStopCardTapped"
                                                  CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                        <Grid x:DataType="models:DeliveryRouteStop">
                            <HorizontalStackLayout Spacing="8" x:DataType="models:DeliveryRouteStop">
                                <HorizontalStackLayout.Triggers>
                                    <DataTrigger TargetType="HorizontalStackLayout"
                                                 Binding="{Binding IsExpanded}"
                                                 Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </HorizontalStackLayout.Triggers>
                                    <Label Text="{Binding Order, StringFormat={x:Static strings:LangResources.StopOrderShortFormatText}}" FontAttributes="Bold" x:DataType="models:DeliveryRouteStop" />
                                <Label Text="{x:Static strings:LangResources.FirstText}"
                                       BackgroundColor="#1E88E5"
                                       TextColor="White"
                                       FontSize="12"
                                       Padding="6,2"
                                        IsVisible="{Binding IsFirst}"
                                        x:DataType="models:DeliveryRouteStop" />
                                <Label Text="{x:Static strings:LangResources.LastText}"
                                       BackgroundColor="#6A1B9A"
                                       TextColor="White"
                                       FontSize="12"
                                       Padding="6,2"
                                        IsVisible="{Binding IsLast}"
                                        x:DataType="models:DeliveryRouteStop" />
                                    <Label Text="{Binding StreetName}" FontAttributes="Bold" x:DataType="models:DeliveryRouteStop" />
                                    <Label Text="{Binding StreetNumberDisplay}" FontAttributes="Bold" x:DataType="models:DeliveryRouteStop" />
                            </HorizontalStackLayout>

                                <VerticalStackLayout Spacing="8" IsVisible="False" x:DataType="models:DeliveryRouteStop">
                                <VerticalStackLayout.Triggers>
                                    <DataTrigger TargetType="VerticalStackLayout"
                                                 Binding="{Binding IsExpanded}"
                                                 Value="True">
                                        <Setter Property="IsVisible" Value="True" />
                                    </DataTrigger>
                                </VerticalStackLayout.Triggers>
                                    <HorizontalStackLayout Spacing="8" x:DataType="models:DeliveryRouteStop">
                                     <Label Text="{Binding Order, StringFormat={x:Static strings:LangResources.StopNumberFormatText}}" FontAttributes="Bold" x:DataType="models:DeliveryRouteStop" />
                                     <Label Text="{x:Static strings:LangResources.FirstText}"
                                         BackgroundColor="#1E88E5"
                                         TextColor="White"
                                         FontSize="12"
                                         Padding="6,2"
                                         IsVisible="{Binding IsFirst}"
                                         x:DataType="models:DeliveryRouteStop" />
                                     <Label Text="{x:Static strings:LangResources.LastText}"
                                         BackgroundColor="#6A1B9A"
                                         TextColor="White"
                                         FontSize="12"
                                         Padding="6,2"
                                         IsVisible="{Binding IsLast}"
                                         x:DataType="models:DeliveryRouteStop" />
                                    </HorizontalStackLayout>
                                <Entry Placeholder="{x:Static strings:LangResources.NamePlaceholderText}" Text="{Binding Name}" x:DataType="models:DeliveryRouteStop" />
                                <Entry Placeholder="{x:Static strings:LangResources.StreetNamePlaceholderText}" Text="{Binding StreetName}" x:DataType="models:DeliveryRouteStop" />
                                <Entry Placeholder="{x:Static strings:LangResources.StreetNumberPlaceholderText}" Text="{Binding StreetNumber}" x:DataType="models:DeliveryRouteStop" />
                                <Label Text="{Binding StreetExtraDetails, StringFormat='Extra: {0}'}"
                                       x:DataType="models:DeliveryRouteStop"
                                       FontSize="12"
                                       TextColor="#6B6B6B">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding StreetExtraDetails}" Value="" x:DataType="models:DeliveryRouteStop">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Entry Placeholder="{x:Static strings:LangResources.PostalCodePlaceholderText}" Text="{Binding PostalCode}" x:DataType="models:DeliveryRouteStop" />
                                <Entry Placeholder="{x:Static strings:LangResources.CityPlaceholderText}" Text="{Binding City}" x:DataType="models:DeliveryRouteStop" />
                                <Entry Placeholder="{x:Static strings:LangResources.CountryPlaceholderText}" Text="{Binding Country}" x:DataType="models:DeliveryRouteStop" />
                                <Button Text="{x:Static strings:LangResources.DeleteStopText}"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnDeleteRouteStopClicked" />
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

                <Frame Grid.Row="4"
                             Margin="0,12,0,0"
                         Padding="12"
                         x:DataType="local:RouteEditorPage"
                         IsVisible="{Binding IsManualStopVisible}">
            <VerticalStackLayout Spacing="8">
                <Label Text="{x:Static strings:LangResources.NewStopManualText}" FontAttributes="Bold" />
                <Entry x:Name="ManualNameEntry" Placeholder="{x:Static strings:LangResources.NamePlaceholderText}" />
                <Entry x:Name="ManualStreetNameEntry" Placeholder="{x:Static strings:LangResources.StreetNamePlaceholderText}" />
                <Entry x:Name="ManualStreetNumberEntry" Placeholder="{x:Static strings:LangResources.StreetNumberPlaceholderText}" />
                <Entry x:Name="ManualPostalCodeEntry" Placeholder="{x:Static strings:LangResources.PostalCodePlaceholderText}" />
                <Entry x:Name="ManualCityEntry" Placeholder="{x:Static strings:LangResources.CityPlaceholderText}" />
                <Entry x:Name="ManualCountryEntry" Placeholder="{x:Static strings:LangResources.CountryPlaceholderText}" />
            </VerticalStackLayout>
        </Frame>

        <Button Grid.Row="5"
                Margin="0,12,0,0"
                Text="{x:Static strings:LangResources.AddRouteStopText}"
                Clicked="OnAddRouteStopClicked" />
    </Grid>
    </ScrollView>
</ContentPage>
