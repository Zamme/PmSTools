<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:PmSTools.Resources.Languages"
             x:Class="PmSTools.RouteCreationPage"
             Title="{x:Static strings:LangResources.RouteCreationPageTitleText}">
    <Grid RowDefinitions="Auto,*,Auto" Padding="16">
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Button Text="Create new route"
                    Clicked="OnCreateNewRouteClicked" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" Margin="0,12,0,0">
            <VerticalStackLayout Spacing="12">
                <Label x:Name="EmptyStateLabel"
                       Text="No routes yet"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />

                <VerticalStackLayout Spacing="12"
                             BindableLayout.ItemsSource="{Binding RouteItems}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                              ColumnSpacing="8">
                                <Button Grid.Column="0"
                                    Text="{Binding DisplayName}"
                                    LineBreakMode="WordWrap"
                                    FontSize="18"
                                    Padding="16,12"
                                    MinimumHeightRequest="56"
                                    BackgroundColor="Orange"
                                    TextColor="White"
                                    CommandParameter="{Binding .}"
                                    Clicked="OnRouteSelectedClicked" />
                            <ImageButton Grid.Column="1"
                                         Source="rename_icon.svg"
                                         WidthRequest="40"
                                         HeightRequest="40"
                                         Padding="8"
                                         BackgroundColor="{StaticResource Secondary}"
                                         CornerRadius="8"
                                         TintColor="{StaticResource MidnightBlue}"
                                         SemanticProperties.Description="Rename route"
                                         CommandParameter="{Binding .}"
                                         Clicked="OnRenameRouteClicked" />
                            <ImageButton Grid.Column="2"
                                         Source="trash_icon.svg"
                                         WidthRequest="40"
                                         HeightRequest="40"
                                         Padding="8"
                                         BackgroundColor="IndianRed"
                                         CornerRadius="8"
                                         TintColor="White"
                                         SemanticProperties.Description="Delete route"
                                         CommandParameter="{Binding .}"
                                         Clicked="OnDeleteRouteClicked" />
                            <ImageButton Grid.Column="3"
                                         Source="arrow_up.svg"
                                         WidthRequest="40"
                                         HeightRequest="40"
                                         Padding="8"
                                         BackgroundColor="{StaticResource Primary}"
                                         CornerRadius="8"
                                         TintColor="White"
                                         IsEnabled="{Binding CanMoveUp}"
                                         SemanticProperties.Description="Move route up"
                                         CommandParameter="{Binding .}"
                                         Clicked="OnMoveRouteUpClicked" />
                            <ImageButton Grid.Column="4"
                                         Source="arrow_down.svg"
                                         WidthRequest="40"
                                         HeightRequest="40"
                                         Padding="8"
                                         BackgroundColor="{StaticResource Primary}"
                                         CornerRadius="8"
                                         TintColor="White"
                                         IsEnabled="{Binding CanMoveDown}"
                                         SemanticProperties.Description="Move route down"
                                         CommandParameter="{Binding .}"
                                         Clicked="OnMoveRouteDownClicked" />
                        </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2"
                Text="Delete all routes"
                BackgroundColor="IndianRed"
                TextColor="White"
                IsEnabled="{Binding HasRoutes}"
                Clicked="OnDeleteAllRoutesClicked" />
    </Grid>
</ContentPage>
