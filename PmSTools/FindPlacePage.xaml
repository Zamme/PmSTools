<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:PmSTools.Resources.Languages"
             x:Class="PmSTools.FindPlacePage"
             Title="{x:Static strings:LangResources.FindPlaceTitleText}">
    <ContentPage.Content>
        <Grid RowDefinitions="Auto, *, Auto">
             <Grid Grid.Column="0" Grid.Row="0" ColumnDefinitions="*,Auto" Padding="8,4">
              <Label Grid.Column="0"
                  Text="{x:Static strings:LangResources.LastSearchPlacesText}"
                  HorizontalOptions="Center"
                  VerticalOptions="Center" />
              <Button Grid.Column="1"
                x:Name="ClearHistoryButton"
                   Text="{x:Static strings:LangResources.ClearText}"
                   Clicked="OnClearLastSearchPlacesClicked"
                   HorizontalOptions="End"
                   VerticalOptions="Center" />
             </Grid>
            <ScrollView Grid.Column="0" Grid.Row="1"
                        x:Name="LastSearchPlacesScroll">
                <VerticalStackLayout
                    x:Name="LastSearchPlacesStack"
                    Spacing="10"
                    Padding="5" />
            </ScrollView>
            <Border Grid.Row="2"
                    StrokeThickness="1"
                    HorizontalOptions="Fill">
                <Grid
                    Padding="5"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        x:Name="TakeAdressFromCameraButton"
                        Text="{x:Static strings:LangResources.TakeText}" 
                        ImageSource="camera_icon_01.png"
                        FontSize="18"
                        BackgroundColor="Blue"
                        BorderColor="BlueViolet"
                        BorderWidth="2"
                        TextColor="WhiteSmoke"
                        FontAttributes="Bold"
                        SemanticProperties.Hint="{x:Static strings:LangResources.TakeAddressFromCameraHintText}"
                        Clicked="OnTakeAdressPhotoButtonClicked"
                        HorizontalOptions="Fill"
                        HeightRequest="80"
                    />
                    <Button
                        Grid.Column="1"
                        x:Name="TakeAdressFromFileButton"
                        ImageSource="folder_icon_01.png"
                        Text="{x:Static strings:LangResources.SelectText}" 
                        FontSize="18"
                        BackgroundColor="Blue"
                        BorderColor="BlueViolet"
                        BorderWidth="2"
                        TextColor="WhiteSmoke"
                        FontAttributes="Bold"
                        SemanticProperties.Hint="{x:Static strings:LangResources.TakeAddressFromFileHintText}"
                        Clicked="OnOpenAdressPictureButtonClicked"
                        HorizontalOptions="Fill"
                        HeightRequest="80"
                    />
                </Grid>
            </Border>
        </Grid>
    </ContentPage.Content>
</ContentPage>